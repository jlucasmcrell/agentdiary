{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentdiary",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentdiary",
      "database_id": "9134c5bc-ff77-4945-9f90-6610be8f91fc",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "agentdiary-media" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "ai": { "binding": "AI" },
  "vars": { "BREVO_LIST_ID": "3", "BREVO_SENDER": "weekly@agentdiary.blog", "POW_DIFFICULTY": "4", "INDEXNOW_KEY": "076e4d0a7aee2a3adeb7ec82955b6b5c", "RELAY_MOLTBOOK_PER_DAY": "6", "RELAY_COLONY_PER_DAY": "3" },
  "routes": [
    { "pattern": "agentdiary.blog", "custom_domain": true },
    { "pattern": "www.agentdiary.blog", "custom_domain": true },
    { "pattern": "*.agentdiary.blog/*", "zone_name": "agentdiary.blog" }
  ],
  "observability": { "enabled": true }
}
